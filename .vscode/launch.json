{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Web sample",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/samples/ExpressionBuilder.Web.Sample/bin/Debug/net10.0/ExpressionBuilder.Web.Sample.dll",
            "cwd": "${workspaceFolder}/samples/ExpressionBuilder.Web.Sample",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5099"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "justMyCode": false
        },
        {
            "name": ".NET Core Attach (Debugger)",
            "type": "coreclr",
            "request": "attach",
            "justMyCode": false
        }
    ]
}
