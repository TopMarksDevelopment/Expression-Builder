{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/ExpressionBuilder.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": ["test", "${workspaceFolder}/ExpressionBuilder.sln"],
            "group": "test",
            "dependsOn": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "test with debugger (Core)",
            "type": "process",
            "isBackground": true,
            "command": "dotnet",
            "args": ["test"],
            "options": {
                "cwd": "${workspaceFolder}/tests/ExpressionBuilder.Core.Tests",
                "env": {
                    "VSTEST_HOST_DEBUG": "1"
                }
            },
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "format (CSharpier)",
            "command": "dotnet",
            "type": "process",
            "args": ["csharpier", "format", "src", "tests", "samples", "tools"],
            "problemMatcher": []
        },
        {
            "label": "web client: build and test",
            "command": "npm",
            "type": "process",
            "args": ["run", "check"],
            "options": {
                "cwd": "${workspaceFolder}/src/ExpressionBuilder.Web/client"
            },
            "problemMatcher": "$tsc"
        },
        {
            "label": "run the web sample",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/samples/ExpressionBuilder.Web.Sample"
            ],
            "isBackground": true,
            "problemMatcher": "$msCompile"
        }
    ]
}
