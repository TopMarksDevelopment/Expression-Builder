@using TopMarksDevelopment.ExpressionBuilder.Web
@model FilterBuilderViewModel
@*
    The markup of the filter builder.

    To change how it looks, copy this file to Views/Shared/Components/FilterBuilder/Default.cshtml in your
    own app (or Pages/Shared/Components/FilterBuilder/Default.cshtml for Razor Pages) and edit it: your
    copy is used instead of this one. Change classes, wrapping elements and text freely, but keep the
    data-eb-* attributes - they are how the script finds each part - and the <template>s, which the
    script copies for every item, group, condition, value, connector and adjustment. The script adds no
    classes of its own except the one for an incomplete condition, which is data-eb-invalid-class below.
*@
@{
    var l = Model.Labels;
}
<div class="eb" id="@Model.Id" data-eb-filter-builder data-eb-invalid-class="eb-invalid">
    <input type="hidden" name="@Model.Name" value="@Model.Json" data-eb-input />
    <script type="application/json" data-eb-schema>@Html.Raw(Model.SchemaJson)</script>

    <div class="eb-root" data-eb-root></div>
    <p class="eb-summary" data-eb-summary role="status"></p>
    <noscript><p class="eb-noscript">@l.NeedsScript</p></noscript>

    @* A group of conditions: the top level, a bracketed group or the items of a collection *@
    <template data-eb-template="group">
        <section class="eb-group" role="group" data-eb-group>
            <header class="eb-group-header">
                <span class="eb-group-title" data-eb-title></span>
                <button type="button" class="eb-btn eb-btn-text eb-btn-remove" data-eb-remove-group>@l.RemoveGroup</button>
            </header>
            <ol class="eb-items" data-eb-items></ol>
            <p class="eb-empty" data-eb-empty>@l.EmptyGroup</p>
            <footer class="eb-group-actions">
                <button type="button" class="eb-btn" data-eb-add-condition>@l.AddCondition</button>
                <button type="button" class="eb-btn" data-eb-add-group>@l.AddGroup</button>
            </footer>
        </section>
    </template>

    @* A place in a group's list for a condition or a group *@
    <template data-eb-template="item">
        <li class="eb-item" data-eb-item></li>
    </template>

    @* One condition: the property, the condition and its value(s), with the advanced options a click away *@
    <template data-eb-template="condition">
        <div class="eb-condition" data-eb-condition>
            <div class="eb-row">
                <select class="eb-select eb-field" data-eb-field aria-label="@l.Field"></select>
                <select class="eb-select eb-operation" data-eb-operation aria-label="@l.Operation"></select>
                <div class="eb-values" data-eb-values></div>
                <button type="button" class="eb-btn eb-btn-text eb-btn-add-value" data-eb-add-value hidden>@l.AddValue</button>
                <button type="button" class="eb-btn eb-btn-icon" data-eb-toggle-options aria-expanded="false" aria-label="@l.Options" title="@l.Options">&#9881;</button>
                <button type="button" class="eb-btn eb-btn-icon eb-btn-remove" data-eb-remove aria-label="@l.RemoveCondition" title="@l.RemoveCondition">&#10005;</button>
            </div>
            <div class="eb-options" data-eb-options hidden>
                <label class="eb-option" data-eb-match-wrap>
                    <span>@l.Match</span>
                    <select class="eb-select" data-eb-match>
                        <option value="Any">@l.MatchAny</option>
                        <option value="All">@l.MatchAll</option>
                    </select>
                </label>
                <fieldset class="eb-option" data-eb-manipulators-wrap>
                    <legend>@l.Manipulators</legend>
                    <div class="eb-manipulators" data-eb-manipulators></div>
                </fieldset>
            </div>
            <p class="eb-error" role="alert" data-eb-error hidden></p>
        </div>
    </template>

    @* One value of a condition. It has a box for most properties and a list for choices (an enum, yes/no): the
       script keeps the one that suits the property and removes the other. data-eb-value-label is optional,
       for designs that show a label with the box; the box is also labelled for screen readers. *@
    <template data-eb-template="value">
        <span class="eb-value" data-eb-value>
            <input class="eb-input" data-eb-control="input" />
            <select class="eb-input" data-eb-control="select"></select>
            <span class="eb-value-joiner" data-eb-value-joiner hidden></span>
            <button type="button" class="eb-btn eb-btn-icon eb-btn-remove-value" data-eb-remove-value aria-label="@l.RemoveValue" title="@l.RemoveValue" hidden>&#8722;</button>
        </span>
    </template>

    @* What joins one item to the next. It goes inside the item it follows, as part of that item's place in the list *@
    <template data-eb-template="connector">
        <div class="eb-item-connector" data-eb-connector-row>
            <select class="eb-select eb-connector-select" data-eb-connector aria-label="@l.Connector">
                <option value="And">@l.And</option>
                <option value="Or">@l.Or</option>
            </select>
        </div>
    </template>

    @* The adjustments ("manipulators") are listed from the schema: the built-in ones, and any custom ones
       under a heading of their own. The heading is hidden when there is only one group. *@
    <template data-eb-template="manipulator-group">
        <div class="eb-manipulator-group" role="group" data-eb-manipulator-group>
            <span class="eb-manipulator-group-title" data-eb-manipulator-group-title></span>
            <div class="eb-manipulator-group-items" data-eb-manipulator-group-items></div>
        </div>
    </template>

    <template data-eb-template="manipulator">
        <div class="eb-manipulator" data-eb-manipulator-item>
            <label><input type="checkbox" data-eb-manipulator /> <span data-eb-manipulator-label></span></label>
            <span class="eb-manipulator-args" data-eb-manipulator-args hidden></span>
        </div>
    </template>

    @* One piece of text an adjustment asks for, such as the text to find *@
    <template data-eb-template="manipulator-arg">
        <input type="text" class="eb-input" data-eb-manipulator-arg />
    </template>
</div>
