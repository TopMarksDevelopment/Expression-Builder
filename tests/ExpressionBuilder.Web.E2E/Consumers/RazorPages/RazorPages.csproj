<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Consumer</RootNamespace>
    <AssemblyName>ConsumerRazorPages</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The version of the package that was just packed; the test passes it in -->
    <PackageReference
      Include="TopMarksDevelopment.ExpressionBuilder.Web"
      Version="$(EbVersion)"
    />
  </ItemGroup>
</Project>
